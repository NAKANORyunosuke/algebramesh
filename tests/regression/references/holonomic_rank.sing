// Holonomic ranks of the GKZ examples of tests/regression, computed with
// Singular 4.2.1 (dmodloc.lib, holonomicRank) independently of the Macaulay2
// driver (Issue #39). The values are recorded in the "reference" of each case.
//
//   Singular -q tests/regression/references/holonomic_rank.sing
//
// H_A(beta) is generated by the toric ideal I_A, computed by elimination
// (the entries of A are nonnegative), and the Euler operators.
LIB "dmodloc.lib";
LIB "elim.lib";
proc gkzrank(intmat A, intvec num, intvec den)
{
  int d = nrows(A); int n = ncols(A);
  ring r = 0,(x(1..n),D(1..n)),dp;
  def W = Weyl(); setring W;
  // I_A = ker(D_j -> s^(a_j)), by elimination (the entries of A are >= 0).
  ring t = 0,(s(1..d),D(1..n)),dp;
  ideal G; int k; int l; poly m;
  for (l = 1; l <= n; l++) {
    m = 1;
    for (k = 1; k <= d; k++) { m = m * s(k)^A[k,l]; }
    G[l] = D(l) - m;
  }
  poly pr = 1;
  for (k = 1; k <= d; k++) { pr = pr * s(k); }
  ideal E = eliminate(G, pr);
  setring W;
  ideal T = imap(t, E);
  ideal I = T;
  int i; int j; poly e;
  for (i = 1; i <= d; i++) {
    e = 0;
    for (j = 1; j <= n; j++) { e = e + A[i,j]*x(j)*D(j); }
    I = I, e - number(num[i])/number(den[i]);
  }
  return(holonomicRank(I));
}
intmat A1[2][4] = 1,1,1,1, 0,1,3,4;
print("jump (1,2): " + string(gkzrank(A1, intvec(1,2), intvec(1,1))));
print("generic (1/2,1/3): " + string(gkzrank(A1, intvec(1,1), intvec(2,3))));
print("(0,0): " + string(gkzrank(A1, intvec(0,0), intvec(1,1))));
print("(2,3): " + string(gkzrank(A1, intvec(2,3), intvec(1,1))));
intmat A2[2][3] = 1,1,1, 0,1,2;
print("rnc (1/2,1/3): " + string(gkzrank(A2, intvec(1,1), intvec(2,3))));
print("rnc (3,4): " + string(gkzrank(A2, intvec(3,4), intvec(1,1))));
print("rnc (0,0): " + string(gkzrank(A2, intvec(0,0), intvec(1,1))));
intmat A3[2][4] = 1,1,1,1, 0,1,2,3;
print("twisted cubic (1/2,1/3): " + string(gkzrank(A3, intvec(1,1), intvec(2,3))));
print("twisted cubic (0,0): " + string(gkzrank(A3, intvec(0,0), intvec(1,1))));
intmat A4[1][2] = 1,2;
print("inhomogeneous [[1,2]] (1/3): " + string(gkzrank(A4, intvec(1), intvec(3))));
quit;
